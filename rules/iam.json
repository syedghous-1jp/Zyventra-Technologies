[
  {
    "id": "IAM-001",
    "name": "IAM Principal Wildcard",
    "severity": "critical",
    "patterns": ["\"Principal\": \"*\"", "\"Principal\": {\"AWS\": \"*\"}"],
    "suggestion": "Replace '*' with 'arn:aws:iam::ACCOUNT_ID:root'",
    "reference": "CIS 1.16"
  },
  {
    "id": "IAM-002",
    "name": "IAM Action Wildcard",
    "severity": "high",
    "patterns": ["\"Action\": \"*\"", "\"Action\": [\"*\""],
    "suggestion": "Use specific actions instead of '*'",
    "reference": "CIS 1.16"
  },
  {
    "id": "IAM-003",
    "name": "IAM PassRole Escalation",
    "severity": "critical",
    "patterns": ["\"Action\": \"iam:PassRole\""],
    "suggestion": "Restrict PassRole to specific trusted roles",
    "reference": "CIS 1.16"
  }
]
